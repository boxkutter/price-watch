# Retail Monitor on Unraid. Copy to ".env" (same folder as docker-compose.yml) and fill in the four
# REQUIRED values. Never commit or share the filled-in file.

# ---- REQUIRED ------------------------------------------------------------------------------
# Database password. Use letters and digits only (it is placed inside a URL).
#   generate one:  openssl rand -hex 24
POSTGRES_PASSWORD=
# Signing/encryption secret, at least 32 characters. It encrypts connector settings (such as an
# API key) in the database: if you change it later, re-enter those settings.
#   generate one:  openssl rand -base64 48
APP_SECRET=
# The administrator you sign in to /admin with. The password needs at least 16 characters.
ADMIN_EMAIL=
ADMIN_PASSWORD=

# ---- Where it lives ------------------------------------------------------------------------
# What you type in the browser to reach it (used in links the service creates).
PUBLIC_BASE_URL=http://192.168.1.50:8085
# Data folder: the database and installed connectors. On a cache-equipped server prefer the cache
# path (/mnt/cache/appdata/retail-monitor) for the database; back this folder up.
DATA_DIR=/mnt/user/appdata/retail-monitor
# Unraid's "nobody:users". Leave unless you know you need another owner.
PUID=99
PGID=100
# Port on the server, and which address it listens on. 0.0.0.0 is the whole LAN; use 127.0.0.1
# if a reverse proxy on this server (SWAG, Nginx Proxy Manager) is the only way in.
HTTP_PORT=8085
BIND_ADDRESS=0.0.0.0
TZ=Europe/Stockholm


# Webhooks must be https to a public address unless you allow otherwise. For a receiver on your own
# network (for example Home Assistant) list its host and, only if it has no TLS, allow http.
# WEBHOOK_PRIVATE_HOSTS=homeassistant.local
# ALLOW_HTTP_WEBHOOKS=false

# Politeness limits (defaults shown). Each connector's own request limits are in its manifest.
# A generic browser string is a compatibility header only; refusals are never worked around.
# API_RATE_LIMIT_PER_MINUTE=300
# MAX_MONITORS_PER_USER=50
# MAX_PENDING_SEARCHES_PER_USER=3
# MAX_SEARCHES_PER_HOUR=20
# MIN_MANUAL_CHECK_INTERVAL_SECONDS=60
# MAX_MY_STORES=15
# MAX_COMPARE_STORES=8

# Connector settings (such as Coop's API key) are NOT put here: enter them in the admin page, on the
# connector's card. They are stored encrypted.
