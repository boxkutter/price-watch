POSTGRES_PASSWORD=change-me
DATABASE_URL=postgresql+psycopg://retail:change-me@postgres:5432/retail
APP_SECRET=replace-with-at-least-32-random-characters
ADMIN_EMAIL=admin@example.invalid
ADMIN_PASSWORD=replace-with-a-long-random-password
PUBLIC_BASE_URL=http://localhost:8085
ALLOW_HTTP_WEBHOOKS=false
WEBHOOK_PRIVATE_HOSTS=
# Politeness limits (defaults shown). Retailer request limits live in each connector manifest.
# A generic browser string is a compatibility header only; refusals are never worked around.
# CONNECTOR_USER_AGENT=Mozilla/5.0 (X11; Linux x86_64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/130.0.0.0 Safari/537.36
# API_RATE_LIMIT_PER_MINUTE=300
# MAX_MONITORS_PER_USER=50
# MAX_PENDING_SEARCHES_PER_USER=3
# MAX_SEARCHES_PER_HOUR=20
# MIN_MANUAL_CHECK_INTERVAL_SECONDS=60
# Coop's data API needs the subscription key coop.se's own pages send (see docs/implementation-status.md).
# Connector settings can also be entered in the admin page (stored encrypted). Values set there
# win over the environment. COOP_API_KEY is the Coop connector's setting.
COOP_API_KEY=
# CONNECTORS_DIR=./data/connectors   # where installed connector packages live (a volume in Docker)
